<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<!--
  Shell root — chỉ chứa thanh tiêu đề + TabPane.
  Tab "Audio & Image" được nhúng từ tab_image_audio.fxml (controller: ImageAudioController).
  Tab "Audio & Video" đang để trống — sẽ triển khai sau.
-->
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.thaivideo.app.ui.MainController"
      spacing="14"
      styleClass="root">

    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>

    <!-- ===== Title ===== -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="Image + Audio → Video" styleClass="title"/>
        <Label text="(FFmpeg · Spring Boot · JavaFX)" styleClass="subtitle"/>
    </HBox>

    <Separator/>

    <!-- ===== Tabs ===== -->
    <TabPane fx:id="tabPane" VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE">
        <tabs>
            <!-- Tab 1: Audio & Image — content được set bằng code (xem MainController) -->
            <Tab text="Audio &amp; Image"/>

            <!-- Tab 2: Audio & Video (đang phát triển) -->
            <Tab text="Audio &amp; Video">
                <VBox alignment="CENTER" spacing="12">
                    <padding>
                        <Insets top="40" right="16" bottom="16" left="16"/>
                    </padding>
                    <Label text="Audio &amp; Video" styleClass="title"/>
                    <Label text="(Tab đang phát triển — chức năng ghép audio vào video có sẵn)"
                           styleClass="subtitle"/>
                </VBox>
            </Tab>
        </tabs>
    </TabPane>
</VBox>
